clear all
fid=fopen('standard.tex','w') % 
fprintf(fid,'%s','\item Solve the folloings equations in $\mathbb{R}$:')
fprintf(fid,'\n')
fprintf(fid,'%s','\begin{enumerate}') % n
fprintf(fid,'\n')

for i=1:1:25 % generate 25 exercises
    ctr=1
    while ctr==1
        a=randi([-10,10],1)
        b=randi([-10,10],1)
        c=randi([-10,10],1)
        d=randi([-10,10],1)
        if a==0 || c==0
            a=-2
            c=3
        end
        alpha=a*c
        beta=a*d+b*c
        gamma=b*d
        if a*d+b*c~=0 && a*d-b*c~=0
            break
        end
    end
    syms x
    ecua= alpha*x^2+beta*x+gamma==0
    exp=latex(sym(ecua))
    %%%% Question construction
    fprintf(fid,'%s %s %s','\item   \[',exp,'\]')
    fprintf(fid,'\n')
end %  fin de las replicas
fprintf(fid,'%s','\end{enumerate}') % cierre de todo el cuestionario
fclose(fid) % cierre del archivo .tex
